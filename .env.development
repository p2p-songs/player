# Dev default: pre-install the local musicmeta addon (metadata plane only —
# see ARCHITECTURE §11). Run it with `PORT=7002 node dist/serve.js` in the
# addons repo. In production, set this to your hosted musicmeta manifest URL;
# leave it unset to seed no default addon.
VITE_DEFAULT_METADATA_ADDON_URL=http://127.0.0.1:7002/manifest.json
